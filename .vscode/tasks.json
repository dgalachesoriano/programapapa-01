{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "C:\\Program Files\\Microsoft Visual Studio\\18\\Community\\MSBuild\\Current\\Bin\\MSBuild.exe",
            "args": [
                "${workspaceFolder}\\GestionFacturas.sln",
                "/p:Configuration=Debug",
                "/v:minimal",
                "/nologo"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
